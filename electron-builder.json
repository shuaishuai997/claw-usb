{
  "appId": "com.openclaw.usb",
  "productName": "OpenClaw U盘版",
  "directories": {
    "output": "dist",
    "buildResources": "."
  },
  "electronDist": "node_modules/electron/dist",
  "files": [
    "**/*",
    "!node_modules/*",
    "!dist/*",
    "!resources/node/**",
    "!resources/openclaw/**",
    "!certs/**",
    "!locales/!(zh-CN)/**"
  ],
  "extraResources": [
    {
      "from": "resources",
      "to": ".",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": "dir",
    "icon": "icon.ico",
    "requestedExecutionLevel": "requireAdministrator",
    "signAndEditExecutable": true,
    "cscKeyPassword": "openclaw-dev",
    "forceCodeSigning": false
  }
}
