{
  "gateway": {
    "port": 18789,
    "controlUi": {
      "allowInsecureAuth": true
    },
    "bind": "loopback"
  },
  "models": {
    "provider": "openai",
    "apiBase": "https://api.deepseek.com/v1",
    "model": "deepseek-chat"
  },
  "skills": {
    "enabled": true
  },
  "paths": {
    "stateDir": "./config",
    "canvasDir": "./config/canvas",
    "credentialsDir": "./config/credentials",
    "sessionsDir": "./config/sessions",
    "logsDir": "./config/logs"
  }
}